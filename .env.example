# MarketFlow AI Service Configuration
APP_ENV=development
APP_NAME=marketflow-ai
HTTP_HOST=0.0.0.0
HTTP_PORT=4001

# PostgreSQL (shared with marketflow-api — same database for pgvector queries)
POSTGRES_URL=postgres://marketflow_user:YOUR_PASSWORD_HERE@localhost:5432/marketflow?sslmode=disable
POSTGRES_MAX_OPEN_CONNS=4
POSTGRES_MAX_IDLE_CONNS=2

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_NAMESPACE=marketflow-ai

# Security
MF_SECURITY_JWKS_URL=https://sso.codevertexafrica.com/api/v1/.well-known/jwks.json
MF_SECURITY_JWT_ISSUER=https://sso.codevertexafrica.com
MF_SECURITY_JWT_AUDIENCE=codevertex
MF_SECURITY_REQUIRE_JWT=true

# Groq AI (Primary LLM — Free Tier)
MF_AI_GROQ_API_KEY=gsk_YOUR_KEY_HERE
MF_AI_GROQ_BASE_URL=https://api.groq.com/openai/v1
# Llama ids are enterprise-only on Groq since 2026-08-16; gpt-oss is pay as you go
# and on the free tier. Retired ids saved anywhere are swapped for these at runtime.
MF_AI_GROQ_ROUTER_MODEL=openai/gpt-oss-20b
MF_AI_GROQ_MAIN_MODEL=openai/gpt-oss-120b
MF_AI_GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
MF_AI_TEMPERATURE=0.7
MF_AI_MAX_TOKENS=2048

# Ollama (Embeddings only)
MF_AI_OLLAMA_URL=http://localhost:11434
MF_AI_EMBEDDING_MODEL=nomic-embed-text
MF_AI_EMBEDDING_DIM=768

# Anthropic (premium class: copy, plans and strategy)
MF_AI_CLAUDE_API_KEY=
MF_AI_CLAUDE_MODEL=claude-haiku-5-5

# MarketFlow API (for KB queries)
MF_AI_MARKETFLOW_API_URL=http://localhost:4000

## Media generation (Sprint 15; docs/integrations/video-generation-providers.md in
## the marketflow docs). Production keys are platform ProviderSettings
## media/<provider> (api_key) on /platform/providers; these are the local fallback.
MF_FAL_API_KEY=YOUR_FAL_KEY_ID:YOUR_FAL_KEY_SECRET
MF_HIGGSFIELD_API_KEY=YOUR_HIGGSFIELD_KEY_ID:YOUR_HIGGSFIELD_KEY_SECRET
# ElevenLabs needs a paid plan for ads (free-plan output is never commercial).
MF_ELEVEN_LABS_API_KEY=YOUR_ELEVENLABS_KEY
# Optional premium templates only (subscription).
MF_CREATOMATE_API_KEY=
MF_CREATOMATE_PUBLIC_TOKEN=
# Optional API base overrides (empty = https://queue.fal.run and https://api.higgsfield.ai)
MF_MEDIA_FAL_QUEUE_URL=
MF_MEDIA_HIGGSFIELD_API_URL=

# Object storage for finished posters and videos (httpware/objectstore).
# Local development: files under MEDIA_ROOT, served by this service at /media.
MEDIA_ROOT=./.media
MEDIA_URL_BASE=http://localhost:4001/media
# Cloudflare R2 (production values come from the cluster Secret)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_PUBLIC_BUCKET=
OBJECT_STORAGE_PRIVATE_BUCKET=
OBJECT_STORAGE_PUBLIC_BASE_URL=
