{
    "schemes": [
        "https",
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "RAG-powered AI chatbot for Forever Living Products marketing automation. Two-tier routing: 8B classifier + 70B responder via Groq, with pgvector RAG and FLP compliance filtering.",
        "title": "MarketFlow AI Service",
        "contact": {},
        "version": "1.0.0"
    },
    "host": "marketflowai.codevertexafrica.com",
    "basePath": "/api/v1",
    "paths": {
        "/ai/pipeline-summary": {
            "post": {
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "CRM AI"
                ],
                "summary": "AI-generated deal pipeline health summary",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Tenant UUID",
                        "name": "X-Tenant-ID",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/ai/score-lead": {
            "post": {
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "CRM AI"
                ],
                "summary": "AI-generated lead score (0–100)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Tenant UUID",
                        "name": "X-Tenant-ID",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/chat": {
            "post": {
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "description": "Processes user question through RAG pipeline: classify intent → embed → search KB → generate response → compliance filter",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Chat"
                ],
                "summary": "Send a chat message to the AI",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Tenant UUID",
                        "name": "X-Tenant-ID",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "Chat message",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.chatRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/rag.ChatResult"
                        }
                    }
                }
            }
        },
        "/chat/sessions/{id}": {
            "delete": {
                "tags": [
                    "Chat"
                ],
                "summary": "Clear a chat conversation",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Tenant slug or UUID",
                        "name": "X-Tenant-ID",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Session UUID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    }
                }
            }
        },
        "/chat/sessions/{id}/turns/{n}": {
            "delete": {
                "tags": [
                    "Chat"
                ],
                "summary": "Delete one question and answer from a conversation",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Tenant slug or UUID",
                        "name": "X-Tenant-ID",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Session UUID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Turn index, 0-based",
                        "name": "n",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/classify": {
            "post": {
                "security": [
                    {
                        "apiKey": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Internal"
                ],
                "summary": "Classify ticket text",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/internal/triage": {
            "post": {
                "security": [
                    {
                        "apiKey": []
                    }
                ],
                "description": "Classifies ticket subject+description into category+priority using the fast LLM router",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Internal"
                ],
                "summary": "AI-classify a support ticket",
                "parameters": [
                    {
                        "description": "Ticket text",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.TriageResult"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "handlers.TriageResult": {
            "type": "object",
            "properties": {
                "category": {
                    "type": "string"
                },
                "confidence": {
                    "type": "number"
                },
                "priority": {
                    "type": "string"
                },
                "reasoning": {
                    "type": "string"
                },
                "requires_human_review": {
                    "type": "boolean"
                },
                "suggested_resolution": {
                    "type": "string"
                }
            }
        },
        "handlers.chatRequest": {
            "type": "object",
            "properties": {
                "business_type": {
                    "description": "\"flp\" | \"generic\" | \"\" (pipeline auto-detects)",
                    "type": "string"
                },
                "question": {
                    "type": "string"
                },
                "session_id": {
                    "type": "string"
                },
                "stream": {
                    "type": "boolean"
                }
            }
        },
        "rag.ChatResult": {
            "type": "object",
            "properties": {
                "cached": {
                    "type": "boolean"
                },
                "confidence": {
                    "type": "number"
                },
                "intent": {
                    "type": "string"
                },
                "model": {
                    "type": "string"
                },
                "response": {
                    "type": "string"
                },
                "sources": {
                    "type": "integer"
                }
            }
        }
    },
    "securityDefinitions": {
        "bearerAuth": {
            "description": "JWT token from auth-service (SSO). Format: Bearer {token}",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}